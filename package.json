{
  "name": "shopnest",
  "version": "1.0.0",
  "description": "ShopNest product management and inventory application",
  "main": "server.js",
  "scripts": {
     "start": "node server.js",
    "dev": "node --watch server.js",
    "lint:frontend": "eslint public",
    "lint:backend": "eslint server.js src config",
    "test:frontend": "node --test test/frontend/*.test.js",
    "test:backend": "node --test test/backend/*.test.js",
    "test": "npm run test:frontend && npm run test:backend",
    "build:frontend": "node --check public/app.js",
    "build:backend": "node --check server.js && node --check src/app.js",
    "build": "npm run build:frontend && npm run build:backend"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "supertest": "^7.1.0",
    "jsdom": "^26.1.0"
  }
}
